{
  "name": "hollowpact",
  "version": "0.2.0",
  "description": "A grim monster-binding contract hunter roguelike deckbuilder",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build.mjs",
    "test": "tsx --test tests/*.test.ts",
    "simulate": "tsx scripts/simulate.ts",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "electron .",
    "package:linux": "npm run build && electron-builder --linux dir",
    "package:windows": "npm run build && electron-builder --win dir",
    "release": "node scripts/release.mjs",
    "test:browser": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evangjones99-gif/Roguelike-deckbuilder.git"
  },
  "keywords": [],
  "author": "Hollowpact contributors",
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/evangjones99-gif/Roguelike-deckbuilder/issues"
  },
  "homepage": "https://github.com/evangjones99-gif/Roguelike-deckbuilder#readme",
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@playwright/test": "^1.63.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "private": true,
  "build": {
    "appId": "com.hollowpact.game",
    "productName": "Hollowpact",
    "directories": {
      "output": "build-desktop"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Game",
      "icon": "desktop/icon.png"
    },
    "win": {
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false,
      "icon": "desktop/icon.png"
    }
  }
}
