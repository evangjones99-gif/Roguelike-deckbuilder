    "import './coherent-native128.css';",
    "import { createCoherentNative128, pixelToolSymbol } from './coherent-native128';",
    "import { portraitFor, toolArtFor } from './art';",
    "const coherentNative128 = createCoherentNative128(new URLSearchParams(window.location.search).get('coherentNative128') === '1');",
    "document.documentElement.classList.toggle('coherent-native128', active);",
    "const portrait = portraitFor(species);",
    "try { arena = createArena($<HTMLCanvasElement>('arena'), coherentNative128, reflectCoherentScene); }",
    "$('hud').innerHTML = `<div class=\"hunter-hud ${isTarget('hunter') ? 'valid-target' : ''}\"><button class=\"hunter-icon hunter-photo\" data-ui=\"hunter\" aria-label=\"Inspect Marek Voss. Hunter: ${state.hp} of ${state.maxHp} health${isTarget('hunter') ? ', select as target' : ''}\">${coherentNative128.requested && coherentNative128.ready ? `<img class=\"coherent-hunter-portrait\" src=\"${escape(coherentNative128.portrait('hunter'))}\" width=\"128\" height=\"128\" alt=\"\">` : ''}</button><div class=\"hunter-health\"><div><strong>${HUNTER_NAME}</strong><span>${icon('heart')} ${state.hp}<small> / ${state.maxHp}</small></span></div><div class=\"health-track\"><i style=\"width:${state.hp / state.maxHp * 100}%\"></i></div></div>${state.block > 0 ? `<span class=\"block-count\">${icon('shield')}${state.block}<small>Block</small></span>` : ''}</div><div class=\"journey-hud\"><span class=\"eyebrow\">${state.phase === 'battle' ? 'ACTIVE CONTRACT' : 'THE CAMPAIGN'}</span><strong>Contract ${(state.phase === 'map' ? state.floor + 1 : state.floor)} <span class=\"subtle\">/ 10</span>${state.phase === 'battle' ? `<span class=\"turn-label\">Turn ${state.turn}</span>` : ''}</strong></div><div class=\"resources\"><span class=\"resource gold\">${icon('gold')}<strong>${state.gold}</strong><small>Gold</small></span>${state.phase === 'battle' ? `<span class=\"resource energy\">${icon('energy')}<strong>${state.energy}</strong><small>Energy</small></span>` : `<span class=\"resource relic\">${icon('moon')}<strong>${state.relics.length}</strong><small>Relics</small></span>`}</div>`;",
    "const nativeArt = card.type === 'summon' && coherentNative128.ready && (card.id === 'cairnhound' || card.id === 'cairnhound+') ? `<img src=\"${escape(coherentNative128.portrait('hound'))}\" width=\"128\" height=\"128\" alt=\"\">` : pixelToolSymbol(card.type === 'summon' ? 'binding' : card.effect || '');",
    "return `<button class=\"game-card ${card.type} ${opts.selected ? 'selected' : ''} ${opts.disabled ? 'unplayable' : ''} ${opts.handIndex === undefined ? 'large-card' : ''}\" ${action} data-index=\"${opts.handIndex ?? ''}\" data-card=\"${escape(card.id)}\" data-focus=\"${opts.handIndex !== undefined ? `card-${opts.handIndex}` : `card-${escape(card.id)}`}\" aria-disabled=\"${!!opts.disabled}\" ${opts.disabled && opts.handIndex === undefined ? 'disabled' : ''} aria-label=\"${escape(card.name)}, ${card.cost} energy. ${escape(cardRules(card))}${opts.disabled ? '. Currently unavailable.' : ''}\"><span class=\"card-cost\">${card.cost}</span><span class=\"card-art ${art ? 'tool-painted' : ''}\" style=\"--card-color:${escape(card.color)}\">${coherentNative128.requested ? `<span class=\"coherent-baseline-art\">${art ? `<canvas data-tool-art=\"${art}\" aria-hidden=\"true\"></canvas>` : ''}${card.type === 'summon' ? creature(card.species, card.color) : icon(card.effect === 'block' ? 'shield' : card.effect === 'heal' ? 'heart' : card.effect === 'draw' ? 'book' : 'energy')}<span class=\"card-art-ring\"></span></span><span class=\"coherent-native-art\">${nativeArt}</span>` : `${art ? `<canvas data-tool-art=\"${art}\" aria-hidden=\"true\"></canvas>` : ''}${card.type === 'summon' ? creature(card.species, card.color) : icon(card.effect === 'block' ? 'shield' : card.effect === 'heal' ? 'heart' : card.effect === 'draw' ? 'book' : 'energy')}<span class=\"card-art-ring\"></span>`}</span><span class=\"card-name\">${escape(card.name)}</span><span class=\"card-kind\">${card.type === 'summon' ? 'BINDING' : `TOOL${target === 'none' ? '' : ' \u00b7 CHOOSE TARGET'}`}</span><span class=\"card-description\">${escape(cardRules(card))}</span>${card.type === 'summon' ? `<span class=\"card-stats\">${icon('battle')} ${card.attack} Attack <span>${icon('heart')} ${card.hp} Health</span></span>` : ''}${opts.reward ? `<span class=\"card-choose\">Add to deck ${icon('arrow')}</span>` : opts.shop ? `<span class=\"card-choose\">${icon('gold')} ${price} gold ${icon('arrow')}</span>` : ''}</button>`;",
    "window.addEventListener('beforeunload', () => { disposed = true; $('dock').replaceChildren(); tactileHand?.dispose(); tactileHand = null; void hostAudio.dispose().catch(() => {}); inputAdapter.dispose(); cancelPresentation(); sceneObserver.disconnect(); toolIllustrations.dispose(); coherentNative128.dispose(); arena?.dispose(); });"
  ]
