     assert m.isfile() and m.size<1048576;v=tar.extractfile(m).read();assert hashlib.sha256(v).hexdigest()==e['manifestSHA256'];manifest=json.loads(v)
    if m.name in {'blobs/'+x['sha256'] for x in raw}:
