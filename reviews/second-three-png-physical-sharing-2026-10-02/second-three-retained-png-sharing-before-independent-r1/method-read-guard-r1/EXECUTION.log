1: from pathlib import Path
2: import os,json,hashlib,time,sys,subprocess,stat
3: S=Path('/workspace/scratch');R=Path('/workspace/Roguelike-deckbuilder')
4: proposal,proposal_sha,gate,gate_sha,judgment,judgment_sha,push,push_sha=sys.argv[1:]
5: def sha(p):
6:  h=hashlib.sha256();fd=os.open(p,os.O_RDONLY|os.O_NOATIME)
7:  with os.fdopen(fd,'rb') as f:
8:   for b in iter(lambda:f.read(65536),b''):h.update(b)
9:  return h.hexdigest()
10: def read(p):return json.loads(Path(p).read_text())
11: def meta(p):
12:  t=os.stat(p);return {k:getattr(t,k) for k in ['st_dev','st_ino','st_mode','st_nlink','st_uid','st_gid','st_size','st_blocks','st_atime_ns','st_mtime_ns','st_ctime_ns']}
13: def syncdir(p):
14:  fd=os.open(p,os.O_RDONLY|os.O_DIRECTORY)
15:  try:os.fsync(fd)
16:  finally:os.close(fd)
17: def save(p,j):
18:  with p.open('x') as f:json.dump(j,f,indent=2);f.write('\n');f.flush();os.fsync(f.fileno())
19:  syncdir(p.parent)
20: for p,h in [(proposal,proposal_sha),(gate,gate_sha),(judgment,judgment_sha),(push,push_sha)]:assert sha(p)==h,p
