49:  assert not ap.is_symlink() and not bp.is_symlink() and stat.S_ISREG(ap.stat().st_mode) and stat.S_ISREG(bp.stat().st_mode)
50:  assert meta(ap)==a['metadata'] and meta(bp)==b['metadata'];assert b['metadata']['st_nlink']==1 and a['metadata']['st_nlink']==5 and a['metadata']['st_dev']==b['metadata']['st_dev']==27
51:  assert not os.listxattr(ap) and not os.listxattr(bp);assert sha(ap)==sha(bp)==a['sha256']==b['sha256'];assert not bp.with_name(bp.name+'.root-share-second-r1.tmp').exists()
